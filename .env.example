# Local development only. Never reuse these values in staging or production.
NODE_ENV=staging
PORT=3000
ROS_RUNTIME_PROFILE=persistent
ROS_AUTH_PROFILE=oidc
ROS_OUTBOX_WORKER_ID=ros-outbox-worker-01
ROS_CONTACT_WORKER_ID=ros-contact-worker-01
OIDC_ISSUER=https://replace-with-your-idp.example/tenant
OIDC_JWKS_URL=https://replace-with-your-idp.example/tenant/.well-known/jwks.json
OIDC_AUDIENCE=ros-api
OIDC_ALLOWED_BINDINGS=[{"clientId":"replace-dashboard-client-id","tenantId":"11111111-1111-4111-8111-111111111111","purpose":"INCIDENT_TRIAGE","roles":["OPERATOR","SUPERVISOR"]},{"clientId":"replace-mobile-client-id","tenantId":"11111111-1111-4111-8111-111111111111","purpose":"INCIDENT_TRIAGE","roles":["FIELD_USER"]}]
OIDC_MAX_TOKEN_AGE_SECONDS=600
OIDC_MAX_CLOCK_SKEW_SECONDS=30
POSTGRES_USER=ros
POSTGRES_PASSWORD=replace-with-random-local-password
POSTGRES_DB=ros
DATABASE_URL=postgresql://ros:replace-with-random-local-password@postgres:5432/ros
REDIS_PASSWORD=replace-with-random-local-password
REDIS_URL=redis://:replace-with-random-local-password@redis:6379
MINIO_ROOT_USER=ros-local
MINIO_ROOT_PASSWORD=replace-with-random-local-password
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=ros-local
OBJECT_STORAGE_SECRET_KEY=replace-with-random-local-password
OBJECT_STORAGE_BUCKET=ros-evidence
ROS_CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1:4174,http://localhost:4173,http://localhost:4174
JWT_SECRET=replace-with-at-least-32-random-bytes
