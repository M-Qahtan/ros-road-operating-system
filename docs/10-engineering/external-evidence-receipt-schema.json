{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ros.example/schemas/external-evidence-receipt-v1.json",
  "title": "ROS immutable external evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "source_run", "archive", "artifacts"],
  "properties": {
    "schema": { "const": "ros-external-evidence/v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "repository_id",
        "workflow",
        "workflow_id",
        "event",
        "conclusion",
        "head_sha",
        "head_branch",
        "run_id",
        "run_attempt",
        "html_url",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "repository": { "const": "M-Qahtan/ros-road-operating-system" },
        "repository_id": { "const": "1310606342" },
        "workflow": { "type": "string", "minLength": 1 },
        "workflow_id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "event": { "enum": ["pull_request", "push", "workflow_dispatch"] },
        "conclusion": { "type": ["string", "null"] },
        "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "head_branch": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "run_attempt": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "html_url": { "type": "string", "format": "uri" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "region", "kms_key_arn", "object_lock_mode", "minimum_retention_days"],
      "properties": {
        "bucket": { "type": "string", "minLength": 3 },
        "region": { "type": "string", "pattern": "^[a-z]{2}(-gov)?-[a-z]+-[0-9]+$" },
        "kms_key_arn": { "type": "string", "pattern": "^arn:[a-z0-9-]+:kms:[a-z0-9-]+:[0-9]{12}:key/[0-9a-f-]+$" },
        "object_lock_mode": { "const": "COMPLIANCE" },
        "minimum_retention_days": { "type": "integer", "minimum": 365 }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "name",
          "size_in_bytes",
          "github_created_at",
          "github_expires_at",
          "sha256",
          "checksum_sha256_base64",
          "object_key",
          "version_id",
          "etag",
          "encryption",
          "kms_key_arn",
          "object_lock_mode",
          "retain_until"
        ],
        "properties": {
          "artifact_id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "name": { "type": "string", "minLength": 1 },
          "size_in_bytes": { "type": "integer", "minimum": 1 },
          "github_created_at": { "type": "string", "format": "date-time" },
          "github_expires_at": { "type": "string", "format": "date-time" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "checksum_sha256_base64": { "type": "string", "minLength": 44, "maxLength": 44 },
          "object_key": { "type": "string", "pattern": "^evidence/github/" },
          "version_id": { "type": "string", "minLength": 1 },
          "etag": { "type": "string" },
          "encryption": { "const": "aws:kms" },
          "kms_key_arn": { "type": "string", "pattern": "^arn:[a-z0-9-]+:kms:" },
          "object_lock_mode": { "const": "COMPLIANCE" },
          "retain_until": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
