aws_region              = "eu-central-1"
expected_aws_account_id = "123456789012"
evidence_bucket_name    = "ros-rel013-evidence-123456789012-eu-central-1"

# Required: reuse the existing account-level GitHub Actions OIDC provider.
# Do not create another provider for token.actions.githubusercontent.com.
existing_github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"

retention_days = 365

tags = {
  Environment = "program-evidence"
  DataClass    = "CI-SAFETY-EVIDENCE"
  Owner        = "ROS-Platform"
  RegionRole   = "Frankfurt-Active"
}
