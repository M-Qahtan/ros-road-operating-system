{
  "name": "@ros/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch dist/main.js",
    "start:outbox-worker": "node dist/outbox-worker-main.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test $(find dist -name '*.spec.js' -print | sort)",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "simulate:riyadh": "pnpm build && node dist/e2e/run-riyadh-pilot.js",
    "simulate:ros-eye": "pnpm build && node dist/e2e/run-ros-eye-pilot.js",
    "evaluate:safety-fusion": "pnpm build && node dist/e2e/run-safety-fusion-evaluation.js",
    "validate:real-device-evidence": "pnpm build && node dist/e2e/run-real-device-evidence-validation.js",
    "validate:partner-sandbox-evidence": "pnpm build && node dist/e2e/run-partner-sandbox-evidence-validation.js",
    "validate:staging-cloud-review": "pnpm build && node dist/e2e/run-staging-cloud-review.js"
  },
  "dependencies": {
    "@ros/contracts": "workspace:*",
    "@ros/domain": "workspace:*",
    "pg": "^8.23.0",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.2"
  }
}
